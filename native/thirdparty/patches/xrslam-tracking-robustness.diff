+void Solver::put_zero_velocity_factor(Frame *frame) {
+    if (!frame->tag(FT_STATIONARY) || frame->tag(FT_FIX_MOTION))
+        return;
+    auto factor = std::make_unique<CeresZeroVelocityFactor>(
+        SolverDetails::config()->stationary_velocity_sigma());
+    details->problem->AddResidualBlock(factor.get(), nullptr,
+                                       frame->motion.v.data());
+    details->managed_zvfactors.emplace_back(std::move(factor));
+}
+
+void Solver::put_no_motion_factor(Frame *frame_i, Frame *frame_j) {
+    if (!frame_j->tag(FT_STATIONARY))
+        return;
+    if (frame_i->tag(FT_FIX_POSE) && frame_j->tag(FT_FIX_POSE))
+        return;
+    const double sigma = SolverDetails::config()->stationary_position_sigma();
+    std::unique_ptr<ceres::CostFunction> factor;
+    if (details->problem->HasParameterBlock(frame_i->pose.p.data())) {
+        factor = std::make_unique<CeresNoMotionFactor>(sigma);
+        details->problem->AddResidualBlock(factor.get(), nullptr, frame_i->pose.p.data(),
+                                           frame_j->pose.p.data());
+    } else {
+        factor = std::make_unique<CeresPositionPriorFactor>(frame_i->pose.p, sigma);
+        details->problem->AddResidualBlock(factor.get(), nullptr, frame_j->pose.p.data());
+    }
+    details->managed_zvfactors.emplace_back(std::move(factor));
+}
