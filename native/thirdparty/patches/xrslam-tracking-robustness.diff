diff --git a/xrslam/src/xrslam/estimation/ceres/zero_velocity_factor.h b/xrslam/src/xrslam/estimation/ceres/zero_velocity_factor.h
new file mode 100644
index 0000000..49829f6
--- /dev/null
+++ b/xrslam/src/xrslam/estimation/ceres/zero_velocity_factor.h
@@ -0,0 +1,87 @@
+#ifndef XRSLAM_CERES_ZERO_VELOCITY_FACTOR_H
+#define XRSLAM_CERES_ZERO_VELOCITY_FACTOR_H
+
+#include <xrslam/common.h>
+
+namespace xrslam {
+
+// Zero-velocity update for a stationary frame: r = v / sigma. Without it a monocular VIO that
+// stands still has no translation to triangulate from, and its velocity is left to the
+// accelerometer bias, which integrates into a position that runs away.
+class CeresZeroVelocityFactor : public ceres::SizedCostFunction<3, 3> {
+  public:
+    explicit CeresZeroVelocityFactor(double sigma) : inv_sigma(1.0 / sigma) {}
+
+    bool Evaluate(const double *const *parameters, double *residuals,
+                  double **jacobians) const override {
+        const_map<vector<3>> v(parameters[0]);
+        map<vector<3>> r(residuals);
+        r = v * inv_sigma;
+        if (jacobians && jacobians[0]) {
+            map<matrix<3, 3, true>> dr_dv(jacobians[0]);
+            dr_dv = matrix<3>::Identity() * inv_sigma;
+        }
+        return true;
+    }
+
+  private:
+    double inv_sigma;
+};
+
+// No-motion update between two consecutive frames when the later one is stationary:
+// r = (p_j - p_i) / sigma. The zero-velocity factor alone still lets position drift: XRSLAM chains
+// still frames into long IMU preintegrations, and an accelerometer bias over many seconds integrates
+// into metres even with both end velocities at zero.
+class CeresNoMotionFactor : public ceres::SizedCostFunction<3, 3, 3> {
+  public:
+    explicit CeresNoMotionFactor(double sigma) : inv_sigma(1.0 / sigma) {}
+
+    bool Evaluate(const double *const *parameters, double *residuals,
+                  double **jacobians) const override {
+        const_map<vector<3>> p_i(parameters[0]);
+        const_map<vector<3>> p_j(parameters[1]);
+        map<vector<3>> r(residuals);
+        r = (p_j - p_i) * inv_sigma;
+        if (jacobians) {
+            if (jacobians[0]) {
+                map<matrix<3, 3, true>> dr_dpi(jacobians[0]);
+                dr_dpi = -matrix<3>::Identity() * inv_sigma;
+            }
+            if (jacobians[1]) {
+                map<matrix<3, 3, true>> dr_dpj(jacobians[1]);
+                dr_dpj = matrix<3>::Identity() * inv_sigma;
+            }
+        }
+        return true;
+    }
+
+  private:
+    double inv_sigma;
+};
+
+// The same when frame_i is not a state of the problem: its position is a constant.
+class CeresPositionPriorFactor : public ceres::SizedCostFunction<3, 3> {
+  public:
+    CeresPositionPriorFactor(const vector<3> &p_i, double sigma)
+        : p_i(p_i), inv_sigma(1.0 / sigma) {}
+
+    bool Evaluate(const double *const *parameters, double *residuals,
+                  double **jacobians) const override {
+        const_map<vector<3>> p_j(parameters[0]);
+        map<vector<3>> r(residuals);
+        r = (p_j - p_i) * inv_sigma;
+        if (jacobians && jacobians[0]) {
+            map<matrix<3, 3, true>> dr_dpj(jacobians[0]);
+            dr_dpj = matrix<3>::Identity() * inv_sigma;
+        }
+        return true;
+    }
+
+  private:
+    vector<3> p_i;
+    double inv_sigma;
+};
+
+} // namespace xrslam
+
+#endif // XRSLAM_CERES_ZERO_VELOCITY_FACTOR_H
