+double Initializer::acceleration_rms() const {
+    // Accelerometer samples rotated into the first sample's frame with the integrated gyro: gravity
+    // becomes a constant there, so their spread is the linear acceleration (plus noise).
+    std::vector<vector<3>> accelerations;
+    quaternion q = quaternion::Identity();
+    double last_t = -1;
+    for (size_t i = 1; i < map->frame_num(); ++i) {
+        for (const ImuData &imu : map->get_frame(i)->preintegration.data) {
+            if (last_t >= 0 && imu.t > last_t) {
+                vector<3> angle = imu.w * (imu.t - last_t);
+                if (angle.norm() > 1e-12) {
+                    q = (q * quaternion(Eigen::AngleAxisd(angle.norm(), angle.normalized())))
+                            .normalized();
+                }
+            }
+            last_t = imu.t;
+            accelerations.push_back(q * imu.a);
+        }
+    }
+    if (accelerations.size() < 10)
+        return 0;
+    // Least-squares line per axis over the sample index; the residual is the motion.
+    const double n = double(accelerations.size());
+    double sx = 0, sxx = 0;
+    vector<3> sy = vector<3>::Zero(), sxy = vector<3>::Zero();
+    for (size_t i = 0; i < accelerations.size(); ++i) {
+        double x = double(i);
+        sx += x;
+        sxx += x * x;
+        sy += accelerations[i];
+        sxy += x * accelerations[i];
+    }
+    vector<3> slope = (n * sxy - sx * sy) / (n * sxx - sx * sx);
+    vector<3> offset = (sy - slope * sx) / n;
+    double variance = 0;
+    for (size_t i = 0; i < accelerations.size(); ++i) {
+        variance += (accelerations[i] - offset - slope * double(i)).squaredNorm();
+    }
+    return std::sqrt(variance / n);
+}
